    <string name="pclink_timeout">無法連線。請確認兩台裝置都連在同一個 Wi-Fi 網路。</string>
    <string name="pclink_remove_title">要取消連結裝置嗎？</string>
    <string name="pclink_remove_msg">「%1$s」將無法再存取你的對話。你可以隨時重新連結。</string>
    <string name="pclink_remove">取消連結</string>
    <string name="pclink_fg_title_pc">已連線到電腦</string>
    <string name="pclink_fg_title_watch">已連線到手錶</string>
    <string name="pclink_fg_waiting">正在等待裝置重新連線…</string>
    <string name="pclink_fg_disconnect">中斷連線</string>
    <string name="pclink_address">這支手機的位址：%1$s</string>
    <string name="pclink_address_hint">如果電腦自己找不到手機，請在電腦上輸入這個位址。</string>
    <string name="pclink_battery_title">背景執行</string>
    <string name="pclink_battery_desc">允許 SinusChat 不受電池限制執行，讓手機螢幕關閉時電腦也能連線。</string>
    <string name="pclink_battery_allow">允許</string>
    <string name="pclink_nearby_channel">電腦距離鎖定</string>
    <string name="pclink_nearby_title">允許存取鄰近裝置</string>
    <string name="pclink_nearby_text">當你帶著手機離開時，SinusChat-Desktop 應該要自動鎖定。輕觸並允許 SinusChat 存取鄰近裝置（藍牙）。</string>
    <string name="prox_setup_channel">電腦鎖定設定</string>
    <string name="prox_setup_notif_title">設定電腦鎖定</string>
    <string name="prox_setup_notif_text">輕觸以完成設定：當你帶著手機離開時鎖定電腦。</string>
    <string name="prox_cancel">取消</string>
    <string name="prox_bt_title">開啟藍牙</string>
    <string name="prox_bt_desc">電腦會透過手機的藍牙訊號得知你就在附近。</string>
    <string name="prox_bt_button">開啟藍牙</string>
    <string name="prox_nearby_title">允許存取鄰近裝置</string>
    <string name="prox_nearby_desc">這樣 SinusChat 就能發送只有你的電腦認得的訊號。</string>
    <string name="prox_nearby_button">允許</string>
    <string name="prox_wait_title">正在連線到電腦…</string>
    <string name="prox_wait_desc">請讓手機靠近電腦。</string>
    <string name="prox_connected_title">已連線</string>
    <string name="prox_connected_desc">電腦已偵測到你的手機。要測試鎖定功能嗎？</string>
    <string name="prox_test_yes">測試</string>
    <string name="prox_test_no">不用了，謝謝</string>
    <string name="prox_test_title">離開電腦</string>
    <string name="prox_test_desc">帶著手機繼續走遠，直到出現「已鎖定」。</string>
    <string name="prox_locked_title">已鎖定</string>
    <string name="prox_locked_desc">當你離開時，電腦就會這樣鎖定。</string>
    <string name="prox_distance_title">你可以變更距離</string>
    <string name="prox_distance_desc">請在電腦上的 SinusChat 中設定：設定 → 螢幕鎖定 → 距離。</string>
    <string name="prox_finish_button">完成</string>
    <string name="prox_done_title">一切就緒</string>
    <string name="prox_done_desc">當你帶著手機離開時，電腦就會鎖定。</string>
    <string name="prox_done_button">關閉</string>
    <string name="pclink_lan_title">允許存取鄰近裝置</string>
    <string name="pclink_lan_desc">Android 封鎖了 SinusChat 存取區域網路，因此電腦無法連線到手機。請允許 SinusChat 存取「鄰近裝置」。</string>
    <string name="pclink_lan_allow">允許</string>
    <string name="prox_test_distance">距離：約 %1$s 公尺</string>
    <string name="prox_test_signal">手機訊號：%1$d dBm</string>
